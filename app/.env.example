# Optional — local dev only. Calls Gemini from the browser (key is visible in dev tools).
# Do NOT use this name on Vercel for production.
REACT_APP_GEMINI_API_KEY=your_gemini_api_key_here

# Production (Vercel): add GEMINI_API_KEY in the project dashboard only —
# Environment Variables → Production → enable "Sensitive".
# Used by api/gemini.js on the server; never exposed to visitors.
